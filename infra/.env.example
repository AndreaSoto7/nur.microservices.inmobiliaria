# NO copies este archivo: genera infra/.env con valores aleatorios:
#   bash infra/scripts/generate-env.sh
IDENTITY_SECRET_KEY=una-clave-larga-y-aleatoria
IDENTITY_DB_PASSWORD=una-contraseña-aleatoria
# Si tu infra/.env es anterior a listing-service, agrega esta línea a mano (openssl rand -hex 16).
LISTING_DB_PASSWORD=una-contraseña-aleatoria
# Si tu infra/.env es anterior a notification-service, agrega esta línea a mano (openssl rand -hex 16).
NOTIFICATION_DB_PASSWORD=una-contraseña-aleatoria
# Si tu infra/.env es anterior a visit-service, agrega esta línea a mano (openssl rand -hex 16)
VISIT_DB_PASSWORD=una-contraseña-aleatoria
# Clave RSA en una sola línea, con los saltos escapados como \n y entre comillas simples.
IDENTITY_JWT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n'
