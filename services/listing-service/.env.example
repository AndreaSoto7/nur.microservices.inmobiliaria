# Variables de listing-service. Spring Boot las lee del entorno; los valores por defecto están en
# src/main/resources/application.properties. Nunca pongas valores reales aquí.

# --- Servicio ---
SERVICE_NAME=listing-service
SERVICE_PORT=8002

# --- Base de datos ---
# En Docker: jdbc:postgresql://listing-db:5432/listing
# Desde el host, con infra/docker-compose.debug.yml: puerto 5434
DB_URL=jdbc:postgresql://localhost:5434/listing
DB_USER=listing
DB_PASSWORD=cambia-esto

# --- Kafka ---
# En Docker: kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- JWT (lo emite identity-service) ---
# En Docker: http://identity-service:8001/api/v1/auth/.well-known/jwks.json
# Desde el host, con infra/docker-compose.debug.yml: http://127.0.0.1:8001/...
JWKS_URI=http://127.0.0.1:8001/api/v1/auth/.well-known/jwks.json
JWT_ISSUER=identity-service
JWT_AUDIENCE=inmobiliaria

# --- Consul (rule service-discovery) ---
CONSUL_HOST=localhost
CONSUL_PORT=8500
# Solo para depurar fuera de Docker: la IP con la que Consul y el gateway llegan a este proceso.
# Si no se define, se usa la IP del contenedor.
# SPRING_CLOUD_CONSUL_DISCOVERY_IP_ADDRESS=
