# NO uses estos valores fuera de tu máquina.
SERVICE_NAME=notification-service
SERVICE_PORT=8005
# Solo para depurar fuera de Docker. Vacío: usa la IP del contenedor.
SERVICE_ADDRESS=

CONSUL_HTTP_ADDR=http://consul:8500

DATABASE_URL=postgres://notification:una-contraseña-de-ejemplo@notification-db:5432/notification
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Validación del access token.
JWKS_URL=http://identity-service:8001/api/v1/auth/.well-known/jwks.json
JWT_ISSUER=identity-service
JWT_AUDIENCE=inmobiliaria
