# Copia este archivo a .env (no se sube a git) y ajusta los valores.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Base de datos ---
# En Docker: postgres://identity:identity@identity-db:5432/identity?connect_timeout=3
# Desde el host, con infra/docker-compose.debug.yml: puerto 5433
DATABASE_URL=postgres://identity:identity@localhost:5433/identity?connect_timeout=3

# --- JWT RS256 ---
# Clave privada de firma. NUNCA en git (*.pem está en .gitignore). Generarla con:
#   mkdir -p keys && openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-private.pem
# En Docker se monta como archivo (secret o volumen de solo lectura) y se apunta aquí.
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
# Alternativa sin archivo: el contenido PEM en una variable, con los saltos de línea escapados (\n).
# JWT_PRIVATE_KEY=
JWT_ISSUER=identity-service
JWT_AUDIENCE=inmobiliaria
# El access debe durar entre 60 y 3600 s y el refresh, más que el access: si no, el servicio no arranca.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# --- Servidor (gunicorn, en el contenedor) ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# --- Service discovery (rule service-discovery) ---
# En el contenedor: CONSUL_ENABLED=true y CONSUL_HTTP_ADDR=http://consul:8500
CONSUL_ENABLED=false
CONSUL_HTTP_ADDR=http://localhost:8500
SERVICE_NAME=identity-service
SERVICE_PORT=8001
# Vacío = IP del contenedor. Solo se llena para depurar fuera de Docker.
SERVICE_ADDRESS=
