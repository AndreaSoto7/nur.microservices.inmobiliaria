# Copia este archivo a .env (no se sube a git) y ajusta los valores.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Base de datos ---
# En Docker: postgres://identity:identity@identity-db:5432/identity
# Desde el host, con infra/docker-compose.debug.yml: puerto 5433
DATABASE_URL=postgres://identity:identity@localhost:5433/identity

# --- Servidor (gunicorn, en el contenedor) ---
GUNICORN_WORKERS=2

# --- Service discovery (rule service-discovery) ---
# En el contenedor: CONSUL_ENABLED=true y CONSUL_HTTP_ADDR=http://consul:8500
CONSUL_ENABLED=false
CONSUL_HTTP_ADDR=http://localhost:8500
SERVICE_NAME=identity-service
SERVICE_PORT=8001
# Vacío = IP del contenedor. Solo se llena para depurar fuera de Docker.
SERVICE_ADDRESS=
