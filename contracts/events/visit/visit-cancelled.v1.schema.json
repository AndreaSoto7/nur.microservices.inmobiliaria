{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inmobiliaria.local/contracts/events/visit/visit-cancelled.v1.schema.json",
  "title": "VisitCancelled v1 payload",
  "description": "Una visita programada fue cancelada por el cliente, el agente asignado o una política de Visit.",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  },
  "required": [
    "visitId",
    "propertyId",
    "clientId",
    "agentId",
    "actor",
    "reason"
  ],
  "properties": {
    "visitId": {
      "$ref": "#/$defs/uuid",
      "description": "Coincide con aggregateId del envelope."
    },
    "propertyId": {
      "$ref": "#/$defs/uuid"
    },
    "clientId": {
      "$ref": "#/$defs/uuid"
    },
    "agentId": {
      "$ref": "#/$defs/uuid"
    },
    "actor": {
      "type": "string",
      "enum": [
        "CLIENT",
        "AGENT",
        "SYSTEM"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?![\\s\\S]*\\u0000)[\\s\\S]*\\S",
      "description": "null cuando el cliente o el agente cancela sin indicar motivo."
    }
  },
  "examples": [
    {
      "visitId": "05de258b-be6c-4f61-b6ac-ac67cc961b03",
      "propertyId": "3f6c2a7e-1b2d-4c8e-9f10-5a6b7c8d9e01",
      "clientId": "81b4586e-348a-48ba-bc93-93341e3b0b4c",
      "agentId": "8a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
      "actor": "CLIENT",
      "reason": null
    }
  ]
}
