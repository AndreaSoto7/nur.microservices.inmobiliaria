{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inmobiliaria.local/contracts/events/listing/property-sold.v1.schema.json",
  "title": "PropertySold v1 (payload)",
  "description": "El agente marcó como vendida una propiedad en venta (desde PUBLISHED o RESERVED). Es definitivo: sale del catálogo. visit rechaza las solicitudes REQUESTED y cancela las visitas SCHEDULED futuras (política 3.3 del ADR 0005).",
  "type": "object",
  "required": ["propertyId", "agentId", "status", "operationType"],
  "properties": {
    "propertyId": { "type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", "description": "Igual al aggregateId del envelope." },
    "agentId": { "type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "status": { "type": "string", "const": "SOLD" },
    "operationType": { "type": "string", "const": "SALE", "description": "Solo una propiedad en venta se puede vender." }
  },
  "additionalProperties": true,
  "examples": [
    {
      "propertyId": "3f6c2a7e-1b2d-4c8e-9f10-5a6b7c8d9e01",
      "agentId": "8a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
      "status": "SOLD",
      "operationType": "SALE"
    }
  ]
}
