# Puerto del gateway: único punto de entrada del cliente.
GATEWAY_PORT=8080

# Service discovery (ADR 0002).
CONSUL_HTTP_ADDR=http://consul:8500
DISCOVERY_REFRESH_INTERVAL=5s

# Orígenes del frontend separados por coma. Comparación exacta: nunca "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Validación del access token.
JWT_ISSUER=identity-service
JWT_AUDIENCE=inmobiliaria

# Requests por minuto, por IP y por ruta, en login y registro.
RATE_LIMIT_AUTH_PER_MINUTE=10

# Espera máxima a que una réplica empiece a responder.
UPSTREAM_TIMEOUT=10s

# Tiempo que una réplica que falló queda fuera del balanceo (Circuit Breaker).
REPLICA_DOWN_DURATION=30s

# Límite de body solo en las subidas de imágenes: listing acepta 5 de 5 MB por request.
# El resto: 64 KB en /api/v1/auth/** y 1 MB por defecto.
MAX_BODY_BYTES=27262976

# Tiempo máximo para recibir el body en /api/v1/auth/**.
AUTH_READ_TIMEOUT=5s
